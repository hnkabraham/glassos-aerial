+/* GlassOS: guessing the PIN. Each wrong code makes the next pair-setup-pin wait longer (1, 2, 4 ... 60 seconds), and
+ * every third one replaces a fixed PIN (raop->pin > 9999, one per run) with a new random one, which the TV shows.
+ * A device trying all 10000 codes then needs days, and the TV keeps showing new codes while it tries. */
+#define PIN_WAIT_MAX_SECS 60
+#define PIN_RENEW_AFTER 3
+
+static uint64_t
+pin_clock_ns() {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (uint64_t) t.tv_sec * SECOND_IN_NSECS + (uint64_t) t.tv_nsec;
+}
+
+static void
+pin_attempt_failed(raop_t *raop) {
+    raop->pin_failures++;
+    unsigned int shift = raop->pin_failures - 1 < 6 ? raop->pin_failures - 1 : 6;
+    uint64_t wait = (uint64_t) 1 << shift;
+    if (wait > PIN_WAIT_MAX_SECS) {
+        wait = PIN_WAIT_MAX_SECS;
+    }
+    raop->pin_retry_ns = pin_clock_ns() + wait * SECOND_IN_NSECS;
+    logger_log(raop->logger, LOGGER_ERR, "pair-setup-pin: wrong code (%u this run), next attempt in %d s",
+               raop->pin_failures, (int) wait);
+    if (raop->pin > 9999 && raop->pin_failures % PIN_RENEW_AFTER == 0) {
+        int pin_4 = random_pin();
+        if (pin_4 < 0) {
+            /* no new code to show: no pairing for the rest of this run, rather than keep the old code */
+            raop->pin_retry_ns = UINT64_MAX;
+            logger_log(raop->logger, LOGGER_ERR, "pair-setup-pin: no random code, pairing refused until restart");
+            return;
+        }
+        raop->pin = (unsigned short) (pin_4 % 10000 + 10000);
+        char pin[6] = { '\0' };
+        snprintf(pin, 5, "%04u", (unsigned int) (pin_4 % 10000));
+        logger_log(raop->logger, LOGGER_ERR, "pair-setup-pin: a new code replaces the old one");
+        if (raop->callbacks.display_pin) {
+            raop->callbacks.display_pin(raop->callbacks.cls, pin);
+        }
+    }
+}
