<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Settings backups in Documents/GlassOS-Aerial (target API 28 keeps the classic shared storage). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Requests the OS uninstall confirmation; does not permit silent removal. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="GlassOS Aerial"
        android:largeHeap="false"
        android:theme="@style/GlassTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:excludeFromRecents="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".HomeWatcher"
            android:exported="false" />

        <!-- App lock: covers a locked app however it opens (a cast, Alexa, a remote button) until its code is entered.
             Its own task, so the right code returns to the app beneath; never in recents or kept once left. -->
        <service
            android:name=".AppLockGuard"
            android:exported="false" />

        <activity
            android:name=".LockActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:taskAffinity="io.github.abhishekkaisar.glassos.lock" />

        <!-- GlassOS scenery as the TV's screensaver, once GlassOS Manager chooses it (secure screensaver_components). The
             permission lets only the system bind it. No android:process: it shares the home's scenery play state. -->
        <service
            android:name=".AerialDream"
            android:exported="true"
            android:label="GlassOS scenery"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Settings > Screensaver > Preview. Landscape like the other screens (a TV does not rotate). -->
        <activity
            android:name=".ScreensaverPreview"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi" />

        <!-- GlassOS Manager's controls (`adb shell content call`). DUMP keeps ordinary apps out (the shell and some
             system apps hold it); ManagerProvider also refuses any caller but the shell and root. -->
        <provider
            android:name=".ManagerProvider"
            android:authorities="${applicationId}.manager"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Fire OS delivers BOOT_COMPLETED to its ~100 receivers one at a time, in priority order: at priority 0
             Glass got it about 1 m 50 s after boot. 999 puts it among the first; LOCKED_BOOT_COMPLETED comes
             within seconds. -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <action android:name="io.github.abhishekkaisar.glassos.KICK" />
            </intent-filter>
        </receiver>

        <!-- Control Center: Sleep and the sleep timer (lockNow). Enabled with `dpm set-active-admin`. -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SleepReceiver"
            android:exported="false" />

        <!-- Control Center: Now Playing (media sessions) and Do Not Disturb. Reads no notifications. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="GlassOS Aerial"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
